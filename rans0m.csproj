<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Ixar</Authors>
    <PackageIcon>stop_sign.png</PackageIcon>
    <AssemblyName>ransom</AssemblyName>
    <ApplicationIcon>main_ico.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <!-- Standalone single-file -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Trim not enabled due to WinForms + NAudio reflection -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="main_ico.ico" />
  </ItemGroup>

  <!-- Clickable coin faces + honey pot: embedded in the single-file exe,
       unpacked at runtime to a created folder in %TEMP% (see AssetManager).
       Nothing loose needs to ship beside the exe. -->
  <ItemGroup>
    <EmbeddedResource Include="Gold_*.png" />
    <EmbeddedResource Include="Honey_Pot.png" />
    <EmbeddedResource Include="Random_A-90.gif" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\stop_sign.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
